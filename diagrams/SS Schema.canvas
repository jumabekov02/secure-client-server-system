		{"id":"3b3cc8eb499a430e","type":"text","text":"### CLIENT HAS:\n\n• client_id + password \n• Private Key \n• Certificate (signed by CA)","x":-417,"y":-55,"width":240,"height":155,"color":"3"},
		{"id":"6acba3e1a94cd2e2","type":"text","text":"# CLIENT","x":-380,"y":-250,"width":145,"height":60,"color":"4"},
